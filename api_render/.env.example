# FIREIA — Servicio de IA: variables de entorno
# Copiar a .env para desarrollo local. NUNCA subir secretos reales a un repo.

# Puerto de escucha (Render lo inyecta automáticamente en producción)
PORT=10000

# Carpeta con los artefactos IA (descargados por descargar_modelo.py)
FIREIA_DATA_DIR=datos_ia

# Modelo principal: random_forest (validado, 193 MB) | gradient_boosting
# (alternativa documentada, 1,1 MB — útil en instancias con poca RAM)
FIREIA_MODELO=random_forest

# Repositorio Hugging Face de origen de los artefactos (público, sin token)
FIREIA_HF_REPO=p400-full/modis-viirs-hotspots-paraguay
